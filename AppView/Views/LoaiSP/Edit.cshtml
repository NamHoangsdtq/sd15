@model AppData.Models.LoaiSP
@{
    ViewData["Title"] = "Edit";
}

<div>
    <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
        <div class="container-fluid px-4">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between pt-3">

                    <!-- Left title -->
                    <div class="col-auto mb-3 d-flex align-items-center">
                        <div class="page-header-icon me-3">
                            <i data-feather="tag"></i>
                        </div>
                        <h4 class="page-header-title m-0">
                            📦 Cập nhật loại sản phẩm cha
                        </h4>
                    </div>

                    <!-- Right button -->
                   

                </div>
            </div>
        </div>
    </header>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="m-0">Thông tin sản phẩm cha </h5>
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
        <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" hidden>
                <label asp-for="ID" class="control-label"></label>
                <input asp-for="ID" type="hidden" class="form-control" />
                <span asp-validation-for="ID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ten" class="control-label">Tên</label>
                <input asp-for="Ten" class="form-control" />
                <span asp-validation-for="Ten" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="TrangThai" class="control-label"></label>
                <input asp-for="TrangThai" type="hidden" class="form-control" value="1" />
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="IDLoaiSPCha" class="control-label"></label>
                <input asp-for="IDLoaiSPCha" class="form-control" />
                <span asp-validation-for="IDLoaiSPCha" class="text-danger"></span>
            </div>
                <div class="form-group d-flex align-items-center gap-2 mt-3">
                    <input type="submit" value="Cập nhật loại sản phẩm" class="btn btn-info" />

                    <a asp-action="Show" class="btn btn-primary">
                        Quay lại danh sách
                    </a>
                </div>

                
        </form>
    </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
