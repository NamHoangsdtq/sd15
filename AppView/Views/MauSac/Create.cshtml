@model AppData.Models.MauSac

@{
    ViewData["Title"] = "Create";
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.0/css/all.css">
}

<div class="row mb-3">
    <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
        <div class="container-fluid px-4">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between pt-3">

                    <!-- Left title -->
                    <div class="col-auto mb-3 d-flex align-items-center">
                        <div class="page-header-icon me-3">
                            <i data-feather="tag"></i>
                        </div>
                        <h4 class="page-header-title m-0">
                            🌈 Thêm màu sắc 
                        </h4>

                    </div>
                </div>
            </div>
        </div>
    </header>



</div>
<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="m-0">Thông tin màu sắc </h5>
    </div>

    <div class="card-body">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
        <form asp-action="Create" id="createForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group" hidden>
                <input asp-for="ID" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Ten" class="control-label">Tên</label>
                <input asp-for="Ten" class="form-control" autocomplete="off" id="TenInput" />
                <div class="invalid-feedback">Vui lòng nhập tên màu sắc!</div>
            </div>

            <div class="form-group">
                <label asp-for="Ma" class="control-label">Mã màu</label>
                <input asp-for="Ma" type="color" class="form-control" style="width: 150px;" id="MaInput" />
                <div class="invalid-feedback">Vui lòng chọn mã màu sắc!</div>
            </div>

            <div class="form-group" hidden>
                <input asp-for="TrangThai" class="form-control" />
            </div>

            <div class="form-group d-flex align-items-center gap-2 mt-3">
                <input type="submit" value="Thêm màu sắc" class="btn btn-success" />


                <a asp-action="Show" class="btn btn-primary ">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Khi người dùng bắt đầu nhập lại, xóa lỗi đi
        $("#TenInput").on("input", function () {
            $(this).removeClass("is-invalid");
        });

        $("#MaInput").on("input", function () {
            $(this).removeClass("is-invalid");
        });

        // Xử lý khi bấm nút Submit
        $("#createForm").submit(function (e) {
            var isValid = true; // Biến cờ để kiểm tra

            var tenInput = $("#TenInput");
            var maInput = $("#MaInput");

            // Validate Tên
            if (tenInput.val().trim() === "") {
                tenInput.addClass("is-invalid"); // Class này sẽ kích hoạt div invalid-feedback hiện lên
                isValid = false;
            }

            // Validate Mã
            // Lưu ý: input type="color" luôn có giá trị mặc định, điều kiện này chỉ chạy nếu bạn đổi sang type="text"
            if (maInput.val().trim() === "") {
                maInput.addClass("is-invalid");
                isValid = false;
            }

            // Nếu có lỗi thì chặn submit form
            if (!isValid) {
                e.preventDefault(); // Chặn form gửi đi
                return false;
            }

            return true;
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}