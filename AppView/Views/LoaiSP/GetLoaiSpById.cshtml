@model AppView.PhanTrang.PhanTrangLoaiSP

@{
    Layout = "~/Views/Shared/_LayoutForAdmin.cshtml";
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/nv.css">
    ViewData["Title"] = "GetLoaiSpById";
    AppData.Models.AssignmentDBContext dBContext = new AppData.Models.AssignmentDBContext();
    int stt = 1;
    string searchData = "";
}

<div class="row mb-3">
    <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
        <div class="container-fluid px-4">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between pt-3">

                    <!-- Left title -->
                    <div class="col-auto mb-3 d-flex align-items-center">
                        <div class="page-header-icon me-3">
                            <i data-feather="tag"></i>
                        </div>
                        <h4 class="page-header-title m-0">
                            📦 Thông tin sản phẩm con
                        </h4>
                    </div>
                    
                    

                </div>
            </div>
        </div>
    </header>



</div>


<table class="table list-unstyled">
    <thead>
        <tr>
            <th class="text-secondary fw-semibold">
                STT
            </th>
            <th class="text-secondary fw-semibold">
                Tên
            </th>
            <th class="text-secondary fw-semibold">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.listlsp)
        {
            <tr>
                <td>
                    <div style="color:black">@stt</div>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Ten)
                </td>
                <td >
                    <button class="btn btn-info ">
                        @Html.ActionLink("Sửa", "EditLoaiSPCon", new { id= item.ID }, new { @style = "color:white;"})
                    </button>
                    
                    <a asp-action="Show" class="btn btn-primary">
                        Quay lại danh sách
                    </a>
                </td>
                @{
                    stt++;
                }
            </tr>
        }
    </tbody>
</table>

