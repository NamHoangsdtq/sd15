@model AppData.Models.ChatLieu

@{
    Layout = "~/Views/Shared/_LayoutForAdmin.cshtml";
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.0/css/all.css" integrity="sha384-lZN37f5QGtY3VHgisS14W3ExzMWZxybE1SJSEsQp9S+oqd12jhcu+A56Ebc1zFSJ" crossorigin="anonymous">
    ViewData["Title"] = "Create";
    AppData.Models.AssignmentDBContext dBContext = new AppData.Models.AssignmentDBContext();
}

<div>
    <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
        <div class="container-fluid px-4">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between pt-3">

                    <!-- Left title -->
                    <div class="col-auto mb-3 d-flex align-items-center">
                        <div class="page-header-icon me-3">
                            <i data-feather="tag"></i>
                        </div>
                        <h4 class="page-header-title m-0">
                            🧵 Thêm chất liệu 
                        </h4>
                    </div>

                    <!-- Right button -->


                </div>
            </div>
        </div>
    </header>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="m-0">Thông tin  chất liệu </h5>
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }
        <div class="card-body">
        <form asp-action="Create" id="createForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Ten" class="control-label">Tên</label>

                <input asp-for="Ten" class="form-control" autocomplete="off" id="TenInput" />

                <div class="invalid-feedback">
                    Tên chất liệu không được bỏ trống!
                </div>
            </div>

            <input type="hidden" asp-for="TrangThai" value="1" />

                <div class="form-group d-flex align-items-center gap-2 mt-3">
                    <input type="submit" value="Thêm chất liệu" class="btn btn-success" />

                    <a asp-action="Show" class="btn btn-primary">
                        Quay lại danh sách
                    </a>
                </div>
        </form>
    </div>
</div>
</div>


<script>
    $(document).ready(function () {
        // 1. Khi người dùng bắt đầu gõ, xóa trạng thái lỗi
        $("#TenInput").on("input", function () {
            $(this).removeClass("is-invalid");
        });

        // 2. Khi nhấn nút Lưu
        $("#createForm").submit(function (e) {
            var tenInput = $("#TenInput");
            var tenValue = tenInput.val();

            // Kiểm tra nếu ô nhập trống hoặc chỉ chứa khoảng trắng
            if (tenValue.trim() === "") {
                tenInput.addClass("is-invalid"); // Thêm class này để hiện dòng chữ đỏ
                e.preventDefault(); // Chặn không cho form gửi đi
                return false;
            }

            return true;
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}