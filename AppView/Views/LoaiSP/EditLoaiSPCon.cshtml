@model AppData.Models.LoaiSP

@{
    ViewData["Title"] = "EditLoaiSPCon";
}

<div class="row mb-3">
    <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
        <div class="container-fluid px-4">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between pt-3">

                    <!-- Left title -->
                    <div class="col-auto mb-3 d-flex align-items-center">
                        <div class="page-header-icon me-3">
                            <i data-feather="tag"></i>
                        </div>
                        <h4 class="page-header-title m-0">
                            📦 Cập nhật loại sản phẩm con
                        </h4>
                    </div>

                    

                </div>
            </div>
        </div>
    </header>



</div>
<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="m-0">Thông tin sản phẩm con  </h5>

        <div class="card-body">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    <div class="col-md-4">
        <form asp-action="EditLoaiSPCon">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" hidden>
                <label asp-for="ID" class="control-label"></label>
                <input asp-for="ID" class="form-control" />
                <span asp-validation-for="ID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ten" class="control-label">Tên</label>
                <input asp-for="Ten" class="form-control" />
                <span asp-validation-for="Ten" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="TrangThai" class="control-label"></label>
                <input asp-for="TrangThai" class="form-control" />
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="form-group" hidden>
                <label asp-for="IDLoaiSPCha" class="control-label"></label>
                <input asp-for="IDLoaiSPCha" class="form-control" />
                <span asp-validation-for="IDLoaiSPCha" class="text-danger"></span>
            </div>
            <div class="form-group">
                        <input type="submit" value="Cập nhật loại sản phẩm" class="btn btn-info" style="margin-top: 10px" />
            </div>
        </form>
    </div>
        </div>
    </div>
</div>



