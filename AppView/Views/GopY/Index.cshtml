@using AppData.Models
@model IEnumerable<GopY>

@{
    Layout = "_LayoutForAdmin";
}

<div class="row mb-3">
    <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
        <div class="container-fluid px-4">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between pt-3">

                    <!-- Left title -->
                    <div class="col-auto mb-3 d-flex align-items-center">
                        <div class="page-header-icon me-3">
                            <i data-feather="tag"></i>
                        </div>
                        <h4 class="page-header-title m-0">
                            ⭐ Danh sách khách hàng góp ý
                        </h4>
                    </div>

                    <!-- Right button -->
                    <div class="col-12 col-xl-auto mb-3">
                        @* <a asp-action="AddSanPham" class="btn btn-primary d-flex align-items-center">

                            <span> 👟 Thêm  sản phẩm mới </span>
                        </a> *@
                        @*  <a asp-action="AddSanPham" class="btn btn-success">Thêm sản phẩm <i class="bi bi-plus-circle"></i></a> *@
                    </div>

                </div>
            </div>
        </div>
    </header>



</div>

<!-- Bộ lọc -->
<form method="get" class="row mb-3">
    <div class="col-md-4">
        <input name="search" class="form-control" placeholder="Tìm theo tên, email, SĐT..." />
    </div>

    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="unread">Chưa đọc</option>
            <option value="read">Đã đọc</option>
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">
            <i class="fa fa-filter"></i> Lọc
        </button>
    </div>
</form>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>SĐT</th>
            <th>Nội dung</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsRead ? "" : "table-warning")">
                <td>@item.Id</td>
                <td>@item.HoTen</td>
                <td>@item.Email</td>
                <td>@item.SoDienThoai</td>
                <td>@item.NoiDung.Substring(0, Math.Min(30, item.NoiDung.Length))...</td>
                <td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>

                <!-- Trạng thái icon -->
                <td class="text-center">
                    @if (!item.IsRead)
                    {
                        <i class="fa fa-envelope text-danger" title="Chưa đọc"></i>
                    }
                    else
                    {
                        <i class="fa fa-check-circle text-success" title="Đã đọc"></i>
                    }
                </td>

                <!-- Action icons -->
                <td class="text-center">

                    <!-- Xem chi tiết -->
                    <button class="btn btn-sm btn-outline-primary"
                            title="Xem"
                            data-bs-toggle="modal"
                            data-bs-target="#detailModal_@item.Id">
                        <i class="fa fa-eye"></i>
                    </button>

                    <!-- Đánh dấu đã đọc -->
                    @if (!item.IsRead)
                    {
                        <form action="/GopY/MarkAsRead" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-sm btn-outline-success" title="Đánh dấu đã đọc">
                                <i class="fa fa-check"></i>
                            </button>
                        </form>
                    }

                    <!-- Xóa -->
                    <form action="/GopY/Delete" method="post" class="d-inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa góp ý này?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-sm btn-outline-danger" title="Xóa">
                            <i class="fa fa-trash"></i>
                        </button>
                    </form>

                </td>
            </tr>

            <!-- Modal xem chi tiết -->
            <div class="modal fade" id="detailModal_@item.Id" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Chi tiết góp ý #@item.Id</h5>
                            <button class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <p><strong>Họ tên:</strong> @item.HoTen</p>
                            <p><strong>Email:</strong> @item.Email</p>
                            <p><strong>SĐT:</strong> @item.SoDienThoai</p>
                            <p><strong>Nội dung:</strong></p>
                            <div class="alert alert-light border">@item.NoiDung</div>
                            <p><strong>Ngày tạo:</strong> @item.NgayTao</p>
                        </div>

                    </div>
                </div>
            </div>
        }
    </tbody>
</table>
