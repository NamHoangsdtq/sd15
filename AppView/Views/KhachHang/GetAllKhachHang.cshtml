@model AppView.PhanTrang.PhanTrangKhachHang

@{
    ViewData["Title"] = "GetAllKhachHang";
    Layout = "~/Views/Shared/_LayoutForAdmin.cshtml";
    int stt = 1;
}
<div class="row mb-3">
    <header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
        <div class="container-fluid px-4">
            <div class="page-header-content">
                <div class="row align-items-center justify-content-between pt-3">

                    <!-- Left title -->
                    <div class="col-auto mb-3 d-flex align-items-center">
                        <div class="page-header-icon me-3">
                            <i data-feather="tag"></i>
                        </div>
                        <h4 class="page-header-title m-0">
                            🧑‍🤝‍🧑 Danh sách khách hàng
                        </h4>
                    </div>

                    <!-- Right button -->
                    <div class="col-12 col-xl-auto mb-3">
                       @*  <a asp-action="AddSanPham" class="btn btn-primary d-flex align-items-center">

                            <span> 👟 Thêm  sản phẩm mới </span>
                        </a> *@
                        @*  <a asp-action="AddSanPham" class="btn btn-success">Thêm sản phẩm <i class="bi bi-plus-circle"></i></a> *@
                    </div>

                </div>
            </div>
        </div>
    </header>



</div>

<div class="col-8">
    <a class="btn btn-primary" asp-action="Create">🧑‍🤝‍🧑Thêm mới khách hàng</a>
</div>
<br />
<form asp-action="GetAllKHTheoTimKiem" asp-controller="KhachHang" method="get" enctype="multipart/form-data">
    <div class="input-group">
        <input type="text" name="Ten" class="form-control" placeholder="Tìm kiếm  theo tên khách hàng ">
        <input type="text" name="SDT" class="form-control" placeholder="Tìm kiếm theo SDT khách hàng">
        <div class="input-group-append">
            <span class="input-group-text bg-transparent text-primary">
                <button type="submit" class="fa fa-search"></button>
            </span>
        </div>
    </div>
</form>
<br />
<table class="table">
    <thead>
        <tr>
            <th style=" background-color: darkslategray; color: white;">STT</th>
            <th style=" background-color: darkslategray; color: white;">Tên</th>
            <th style=" background-color: darkslategray; color: white;">Giới tính</th>
            <th style=" background-color: darkslategray; color: white;">Ngày sinh</th>
            <th style=" background-color: darkslategray; color: white;">Email</th>
            <th style=" background-color: darkslategray; color: white;">Địa chỉ</th>
            <th style=" background-color: darkslategray; color: white;">Số điện thoại</th>
            <th style=" background-color: darkslategray; color: white;">Trạng thái</th>
            <th style=" background-color: darkslategray; color: white;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.listkh)
        {
            <tr>
                <td>
                    <strong style="color:black">@stt</strong>
                </td>
                <td>
                    @item.Ten
                </td>
                <td>
                    @if (item.GioiTinh == 0)
                    {
                        <div style="color:black">Nữ</div>
                    }
                    @if (item.GioiTinh == 1)
                    {
                        <div style="color:black">Nam</div>
                    }
                    @if (item.GioiTinh == null)
                    {
                        <div style="color:green"></div>
                    }
                </td>
                <td>
                    @item.NgaySinh?.ToString("dd/MM/yyyy")
                </td>
                <td>
                    <div>@item.Email</div>
                </td>
                <td>
                    @item.DiaChi
                </td>
                <td>
                    @item.SDT
                </td>
                <td>
                    @if (item.TrangThai == 0)
                    {
                        <div style="color:red">Không Hoạt Động</div>
                    }
                    else
                    {
                        <div style="color:green">Hoạt Động</div>
                    }
                </td>
                <td>
                    @* <button class="btn btn-success">
                        @Html.ActionLink("Sửa", "Updates", new { id = item.IDKhachHang }, new { @style = "color:white;" })
                    </button> *@
                    <a href="@Url.Action("Updates", new { id = item.IDKhachHang })"
                       class="btn btn-warning text-dark" title="Sửa">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                    @* <button class="btn btn-primary">
                        @Html.ActionLink("Lịch sử mua hàng", "GetAllLSTDByIDKH", new { id = item.IDKhachHang }, new { @style = "color:white;" })
                    </button> *@
                    <a href="@Url.Action("GetAllLSTDByIDKH", new { id = item.IDKhachHang })"
                       class="btn btn-info text-white" title="Chi tiết">
                        <i class="fa-solid fa-eye"></i>
                    </a>
                </td>
                @{
                    stt++;
                }
            </tr>
        }
    </tbody>
</table>
<div class="col-12">
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.PagingInfo.TotalPages; i++)
            {
                <li class="page-item"><a class="page-link" href="/KhachHang/GetAllKhachHang?ProductPage=@i">@i</a></li>
            }
        </ul>
    </nav>
</div>